        "align_by": "semantic_window",
        "source_cue_alignment_required": false,
        "overlap_next_semantic_window_allowed": false
      },
      "source_reference": {
        "asr_document_brief_usage": "reference_only",
        "full_source_reanalysis_required": true,
        "description": "ASR 阶段的全文概述只作参考；本土化仍须重新通读完整英文原文。"
      },
      "subtitle": {
        "profile_id": "general_zh_hans",
        "label": "简体中文通用上屏字幕"
      }
