      "expression": {
        "goal": "像中文母语者在当前内容场景下自然表达，而不是逐句翻译",
        "preserve": [
          "事实、数字、专名、否定和因果关系",
          "人物的专业程度、态度、情绪和说话节奏",
          "与文化背景无关的人格特征"
        ],
        "adapt": [
          "按中国大陆口语习惯重组句子和篇章",
          "把情绪、惊叹、幽默和网络口语换成强度相近的中文表达",
          "把文化相关说法替换成中国观众能自然理解的等效表达"
        ],
        "avoid": [
          "逐句对应英文字幕条",
          "为了覆盖每个英文单词而保留翻译腔",
          "把固定中英词表当成文化迁移规则"
        ]
      },
      "timing": {
        "policy_id": "semantic_window",
        "label": "按画面语义时间对应",
